{
  "name": "@vibecode-db/client",
  "version": "3.0.0-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Universal database SDK with Supabase-compatible API and swappable adapters",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/mock": {
      "types": "./dist/adapters/mock/index.d.ts",
      "import": "./dist/adapters/mock/index.js",
      "require": "./dist/adapters/mock/index.cjs"
    },
    "./adapters/supabase": {
      "types": "./dist/adapters/supabase/index.d.ts",
      "import": "./dist/adapters/supabase/index.js",
      "require": "./dist/adapters/supabase/index.cjs"
    },
    "./adapters/pocketbase": {
      "types": "./dist/adapters/pocketbase/index.d.ts",
      "import": "./dist/adapters/pocketbase/index.js",
      "require": "./dist/adapters/pocketbase/index.cjs"
    },
    "./adapters/rest": {
      "types": "./dist/adapters/rest/index.d.ts",
      "import": "./dist/adapters/rest/index.js",
      "require": "./dist/adapters/rest/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "database",
    "supabase",
    "pocketbase",
    "sdk",
    "adapter"
  ],
  "author": "Sanket Sahu",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@types/node": "^25.4.0",
    "pocketbase": "^0.26.8",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "pocketbase": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "pocketbase": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
