# Adapter type: "mock" (default), "supabase", or "pocketbase"
EXPO_PUBLIC_ADAPTER_TYPE=mock

# Supabase (required when ADAPTER_TYPE=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PocketBase (required when ADAPTER_TYPE=pocketbase)
EXPO_PUBLIC_POCKETBASE_URL=http://localhost:8090
