{
    "name": "@vibecode-db/client",
    "version": "2.6.0",
    "description": "Core Vibecode DB client + Supabase adapter",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --dts --sourcemap --format cjs,esm --clean",
        "dev": "tsup src/index.ts --dts --sourcemap --format cjs,esm --watch"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./adapters/supabase": {
            "types": "./dist/adapters/supabase/index.d.ts",
            "import": "./dist/adapters/supabase/index.mjs",
            "require": "./dist/adapters/supabase/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "peerDependencies": {
        "@supabase/supabase-js": "^2.57.4",
        "@react-native-async-storage/async-storage": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "@react-native-async-storage/async-storage": {
            "optional": true
        }
    },
    "dependencies": {
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.44.1",
        "@typescript-eslint/parser": "^8.44.1",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    }
}